FROM debian:latest

RUN apt-get update && mkdir -p /tmp \
    # 1. 仅通过 apt-cache 查询 nginx-extras 的候选版本号并存为变量
    && EXTRAS_VER=$(apt-cache policy nginx-extras | grep Candidate | awk '{print $2}') \
    # 2. 直接提取出不带 Debian 后缀的基础版本号 (例如: 1.26.3)
    && echo "$EXTRAS_VER" | cut -d '-' -f 1 > /tmp/nginx_version.txt \
    # 3. 提取完整的修订版本号 (例如: 1.26.3-3+deb13u5)
    && echo "$EXTRAS_VER" > /tmp/nginx_extras_version.txt \
    # 清理缓存
    && rm -rf /var/lib/apt/lists/*

CMD ["cat", "/tmp/nginx_extras_version.txt"]
